# Copy to .env and fill in. .env is gitignored - never commit a real key.

# --- Extraction provider credentials ------------------------------------
# Only the provider you actually use needs a key.

GEMINI_API_KEY=
# Optional override; defaults to gemini-3.7-flash.
# GEMINI_MODEL=gemini-3.7-flash

# --- Application ---------------------------------------------------------
# Absolute path to Fakturama.exe. If unset, the launcher searches the usual
# install locations (C:\Program Files\Fakturama2\ and friends).
# FAKTURAMA_EXE=C:\Program Files\Fakturama2\Fakturama.exe
